# ── Dependencies ─────────────────────────────────────────────
vendor/
node_modules/

# ── Version control ───────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── User uploads (mounted as volume) ─────────────────────────
uploads/
public/uploads/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
storage/logs/

# ── Environment & secrets ─────────────────────────────────────
.env
.env.*
!.env.example

# ── OS / editor files ─────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ── Docker files themselves (not needed inside container) ─────
docker-compose*.yml
docker-compose.override.yml

# ── Tests & CI ────────────────────────────────────────────────
tests/
.github/
.travis.yml
phpunit.xml*

# ── Node build artifacts ──────────────────────────────────────
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock
