{
    "name": "petkardex/petkardex",
    "description": "PetKardex v2 — ERP Veterinario con gestión de pacientes, historial clínico, QR y más",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "CESAR AQUINO ANGLAS - VI B NOCHE",
            "role": "Developer & Author",
            "homepage": "https://github.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "endroid/qr-code": "^5.0",
        "dompdf/dompdf": "^3.0",
        "phpmailer/phpmailer": "^6.9",
        "tecnickcom/tcpdf": "^6.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "PetKardex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PetKardex\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "app-name": "PetKardex",
        "app-version": "2.0.0"
    }
}
