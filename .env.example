# ════════════════════════════════════════════════════════════════
# PetKardex v2 — Variables de Entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA versiones el archivo .env con valores sensibles.
# ════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# SECCIÓN: Aplicación (App)
# ──────────────────────────────────────────────────────────────

# Entorno de ejecución: 'development' muestra errores en pantalla,
# 'production' los suprime y los escribe en log.
APP_ENV=development

# URL base de la aplicación (sin barra final).
# En Docker local normalmente es http://localhost:8080
APP_URL=http://localhost:8080

# Clave secreta para firmar tokens CSRF y otros hashes de sesión.
# Genera una aleatoria con: php -r "echo base64_encode(random_bytes(32));"
# Mínimo 32 caracteres aleatorios.
APP_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_32_CHARS

# Nombre de la aplicación (aparece en el título de las páginas y emails)
APP_NAME=PetKardex

# Zona horaria del servidor (ver lista en https://www.php.net/timezones)
TIMEZONE=America/Lima

# Tiempo de vida de la sesión en segundos (7200 = 2 horas)
SESSION_LIFETIME=7200

# ──────────────────────────────────────────────────────────────
# SECCIÓN: Base de Datos (Database)
# ──────────────────────────────────────────────────────────────

# Host del servidor MySQL.
# En Docker Compose usar el nombre del servicio: 'db'
# En servidor local usar: '127.0.0.1'
DB_HOST=db

# Puerto de MySQL (por defecto 3306)
DB_PORT=3306

# Nombre de la base de datos
DB_NAME=petkardex

# Usuario de MySQL con permisos sobre DB_NAME
DB_USER=petkardex_user

# Contraseña del usuario de BD.
# Debe coincidir con MYSQL_PASSWORD en docker-compose.yml
DB_PASSWORD=CAMBIA_ESTO_POR_TU_PASSWORD_DE_BD

# Charset de la conexión (no cambiar salvo requisito especial)
DB_CHARSET=utf8mb4

# Contraseña del usuario root de MySQL (solo necesaria para docker-compose)
DB_ROOT_PASSWORD=CAMBIA_ESTO_POR_TU_PASSWORD_ROOT

# ──────────────────────────────────────────────────────────────
# SECCIÓN: Correo Electrónico (Mail / SMTP)
# ──────────────────────────────────────────────────────────────

# Host del servidor SMTP.
# En desarrollo con Docker usar 'mailhog' (captura todos los emails).
# En producción: smtp.gmail.com, smtp.sendgrid.net, etc.
SMTP_HOST=mailhog

# Puerto SMTP:
# 1025 → MailHog (dev)
# 587  → TLS (producción recomendado)
# 465  → SSL
# 25   → Sin cifrado (no recomendado)
SMTP_PORT=1025

# Usar TLS (STARTTLS): true o false
# Dejar false para MailHog, true para servidores SMTP reales
SMTP_TLS=false

# Usuario SMTP (email o cuenta)
# Dejar vacío para MailHog
SMTP_USER=

# Contraseña SMTP
# Dejar vacío para MailHog
SMTP_PASSWORD=

# Dirección de email del remitente en los envíos del sistema
SMTP_FROM=noreply@petkardex.local

# Nombre que aparece como remitente en los emails
SMTP_FROM_NAME=PetKardex Sistema Veterinario

# Email del administrador para notificaciones críticas del sistema
ADMIN_EMAIL=admin@petkardex.local

# ──────────────────────────────────────────────────────────────
# SECCIÓN: Sistema QR
# ──────────────────────────────────────────────────────────────

# URL base que se incrusta en los códigos QR de los pacientes.
# Debe ser la URL pública de la aplicación (accesible desde internet
# o red local si los QR se usan internamente).
# Ejemplo producción: https://mi-clinica.com
QR_BASE_URL=http://localhost:8080

# Tamaño en píxeles de la imagen QR generada (ancho y alto)
QR_SIZE=300

# Nivel de corrección de errores del QR:
# L=7%, M=15%, Q=25%, H=30% (mayor = más robusto pero más denso)
QR_ERROR_CORRECTION=M

# Margen en "módulos" alrededor del código QR (mínimo 4 recomendado)
QR_MARGIN=4

# ──────────────────────────────────────────────────────────────
# SECCIÓN: Seguridad (Security)
# ──────────────────────────────────────────────────────────────

# Número de intentos de login fallidos antes de bloquear la cuenta
# temporalmente (rate limiting)
MAX_LOGIN_ATTEMPTS=5

# Tiempo de bloqueo en segundos tras superar MAX_LOGIN_ATTEMPTS (900 = 15 min)
LOGIN_LOCKOUT_SECONDS=900

# Duración en segundos del token de restablecimiento de contraseña
# 3600 = 1 hora
PASSWORD_RESET_TOKEN_TTL=3600

# Enviar cookies de sesión solo por HTTPS:
# 'false' en desarrollo local, 'true' en producción con SSL
SESSION_SECURE=false

# ──────────────────────────────────────────────────────────────
# SECCIÓN: Subida de Archivos (Uploads)
# ──────────────────────────────────────────────────────────────

# Tamaño máximo de archivo subido en bytes
# 20971520 = 20 MB
UPLOAD_MAX_SIZE=20971520

# Extensiones permitidas para fotos de pacientes/propietarios/usuarios
# (separadas por coma, sin espacios)
UPLOAD_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif

# Extensiones permitidas para documentos
UPLOAD_DOC_EXTENSIONS=pdf,doc,docx

# Ruta relativa (desde la raíz del proyecto) donde se guardan los archivos
# subidos. Debe tener permisos de escritura (chmod 755)
UPLOAD_PATH=public/uploads

# Ruta relativa donde se almacenan las imágenes QR generadas
QR_PATH=public/uploads/qr
